{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tenant-config.schema.json",
  "title": "TenantConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "name",
    "shortName",
    "branding",
    "timezone",
    "locales",
    "enabledFeatures",
    "legalLinks",
    "serviceArea",
    "supportContacts",
    "contentVersion"
  ],
  "properties": {
    "tenantId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "shortName": {
      "type": "string"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logoUrl", "primaryColor", "infoColor"],
      "properties": {
        "logoUrl": {
          "type": "string"
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "infoColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "timezone": {
      "type": "string"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "enabledFeatures": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "legalLinks": {
      "type": "object"
    },
    "serviceArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "reportingOffice", "phone", "email"],
      "properties": {
        "city": { "type": "string" },
        "reportingOffice": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "supportContacts": {
      "type": "array"
    },
    "contentVersion": {
      "type": "string"
    }
  }
}
