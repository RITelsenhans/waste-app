{
  "name": "@waste/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "cap:add:ios": "cap add ios --packagemanager SPM",
    "cap:open:ios": "cap open ios",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@waste/api-client": "workspace:*",
    "@waste/design-tokens": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@waste/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
