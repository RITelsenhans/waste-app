{
  "name": "Abfall APP Demo",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/waste-app",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Geschützte Abfall-APP-Demo",
      "onAutoForward": "notify"
    },
    "3001": {
      "onAutoForward": "ignore"
    },
    "8080": {
      "onAutoForward": "ignore"
    },
    "55432": {
      "onAutoForward": "ignore"
    },
    "8025": {
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "corepack pnpm install --frozen-lockfile",
  "remoteUser": "vscode"
}
